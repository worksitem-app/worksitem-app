    const target = document.getElementById("geometryFields");
    const fields = GEOMETRY_FIELDS[type] || [];

    target.innerHTML = fields.map(function(field) {
        return '<div class="form-group">' +
            '<label>' + field[1] + '</label>' +
            '<input type="number" class="form-control geometry-input" ' +
            'data-field="' + field[0] + '" value="' + field[2] + '" step="any" min="0">' +
            '</div>';
    }).join("");
}

function geometryValue(name) {
    const el = document.querySelector('[data-field="' + name + '"]');
    return el ? (parseFloat(el.value) || 0) : 0;
}

function calculateGeometryVolume() {
    const type = document.getElementById("geometryType").value;

    if (type === "slab" || type === "raft") {
        return geometryValue("area") * (geometryValue("thickness") / 100);
    }

    if (type === "footing") {
        return geometryValue("width") *
            geometryValue("length") *
            (geometryValue("height") / 100) *
            geometryValue("count");
    }

    if (type === "strip") {
        return geometryValue("width") *
            (geometryValue("height") / 100) *
            geometryValue("length");
    }

    if (type === "column_rect") {
        return (geometryValue("width") / 100) *
            (geometryValue("depth") / 100) *
            geometryValue("height") *
            geometryValue("count");
    }

    if (type === "column_round") {
        const radius = geometryValue("diameter") / 200;
        return Math.PI * radius * radius *
            geometryValue("height") *
            geometryValue("count");
    }

    if (type === "beam") {
        return (geometryValue("width") / 100) *
            (geometryValue("height") / 100) *
            geometryValue("length") *
            geometryValue("count");
    }

    if (type === "wall") {
        return geometryValue("length") *
            geometryValue("height") *
            (geometryValue("thickness") / 100) *
            geometryValue("count");
    }

    if (type === "stair") {
        const run = geometryValue("run");
        const rise = geometryValue("rise");
        const width = geometryValue("width");
        const waist = geometryValue("waist") / 100;

        const slope = Math.sqrt((run * run) + (rise * rise));
        const waistVolume = slope * width * waist;

        const stepVolume =
            geometryValue("stepCount") *
            ((geometryValue("tread") / 100) *
             (geometryValue("riser") / 100) / 2) *
            width;

        const landingVolume =
            geometryValue("landingArea") * waist;

        return waistVolume + stepVolume + landingVolume;
    }

    if (type === "pile") {
        const radius = geometryValue("diameter") / 200;
        return Math.PI * radius * radius *
            geometryValue("length") *
            geometryValue("count");
    }

    return 0;
}

