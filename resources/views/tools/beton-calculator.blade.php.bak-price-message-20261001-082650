    const pumpPrice = pumpRecord === null
        ? 0
        : Number(pumpRecord.price);

    if (Number.isFinite(volume) === false || volume <= 0) {
        alert('Lütfen geçerli ölçüler giriniz.');
        return;
    }

    const hasConcretePrice =
        concrete !== null &&
        Number.isFinite(concretePrice) &&
        concretePrice > 0;

    const hasPumpPrice =
        pumpRecord !== null &&
        Number.isFinite(pumpPrice) &&
        pumpPrice > 0;

    const volumeWithWaste = volume * 1.05;

    const pumpCost =
        pumpRequested && hasPumpPrice
            ? pumpPrice
            : 0;

    const total =
        hasConcretePrice
            ? (volumeWithWaste * concretePrice) + pumpCost
            : null;
    const mixers = Math.ceil(volumeWithWaste / 8);

    renderConcreteMaterials(
        volumeWithWaste,
        role
    );

    const money = new Intl.NumberFormat(
        'tr-TR',
        { maximumFractionDigits: 0 }
    );

    document.getElementById('resPrice').innerText =
        total === null
            ? 'Fiyat tanımlanmadı'
            : money.format(total) + ' TL';

    document.getElementById('resVol').innerText =
        volumeWithWaste.toFixed(1) + ' m³';

    document.getElementById('resNetVol').innerText =
        'Net hacim: ' + volume.toFixed(2) + ' m³';

    document.getElementById('resMixer').innerText =
        mixers + ' Sefer';

    const ai = document.getElementById('aiText');

    if (role === 'lean_concrete') {
        ai.innerText =
            'Grobeton, temel altı hazırlık ve temiz çalışma yüzeyi amacıyla değerlendirilir.';
    } else {
        ai.innerText =
            'Beton sınıfı statik proje, çevresel etki sınıfı ve teknik şartnameye göre yetkili mühendis tarafından belirlenmelidir.';
    }

    document.getElementById('resBox').style.display = 'block';
    document.getElementById('bConf').style.display = 'block';
    document.getElementById('leadForm').style.display = 'none';
};

document.getElementById('bYes').onclick = () => {
    document.getElementById('bConf').style.display = 'none';
    document.getElementById('leadForm').style.display = 'block';
};

document.getElementById('bNo').onclick = () => {
    document.getElementById('bConf').innerHTML =
        '<p>Bizi tercih ettiğiniz için teşekkürler.</p>';
};
</script>
