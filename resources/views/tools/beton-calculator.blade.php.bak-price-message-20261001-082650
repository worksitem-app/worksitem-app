<script>
const concretePrices = @json($concretePriceData);

const CONCRETE_MIXES = {
    concrete_c20: {
        label: "C20/25",
        cement: 260,
        sand: 670,
        aggregate: 1070,
        water: 177,
        additive: 0
    },

    concrete_c25: {
        label: "C25/30",
        cement: 310,
        sand: 640,
        aggregate: 1120,
        water: 167,
        additive: 0
    },

    concrete_c30: {
        label: "C30/37",
        cement: 360,
        sand: 600,
        aggregate: 1130,
        water: 157,
        additive: 0
    },

    concrete_c35: {
        label: "C35/45",
        cement: 390,
        sand: 580,
        aggregate: 1140,
        water: 155,
        additive: 4
    }
};


function calculateConcreteMaterials(volume, concreteClass) {
    const mix = CONCRETE_MIXES[concreteClass] || null;

    if (
        mix === null ||
        Number.isFinite(volume) === false ||
        volume <= 0
    ) {
        return null;
    }

    const cementKg = volume * mix.cement;
    const sandKg = volume * mix.sand;
    const aggregateKg = volume * mix.aggregate;
    const waterLiters = volume * mix.water;
    const additiveKg = volume * mix.additive;

    return {
        label: mix.label,
        volume: volume,

        cementKg: cementKg,
        cementTon: cementKg / 1000,
        cementBags50: cementKg / 50,

        sandKg: sandKg,
        sandTon: sandKg / 1000,

        aggregateKg: aggregateKg,
        aggregateTon: aggregateKg / 1000,

        waterLiters: waterLiters,
        waterM3: waterLiters / 1000,

        additiveKg: additiveKg
    };
}


function renderConcreteMaterials(volume, concreteClass) {
    const box = document.getElementById('materialBreakdown');
    const classText = document.getElementById('materialClass');
    const additiveBox = document.getElementById('materialAdditiveBox');

    const materials = calculateConcreteMaterials(
        volume,
        concreteClass
    );

    box.style.display = 'block';

    if (materials === null) {
        classText.textContent =
            'Bu beton sınıfı için referans karışım verisi tanımlanmadı.';

        document.getElementById('materialCement').textContent = '—';
        document.getElementById('materialCementBag').textContent = '';
        document.getElementById('materialSand').textContent = '—';
        document.getElementById('materialAggregate').textContent = '—';
        document.getElementById('materialWater').textContent = '—';

        additiveBox.style.display = 'none';
        return;
    }

    const number0 = new Intl.NumberFormat(
        'tr-TR',
        { maximumFractionDigits: 0 }
    );

    const number2 = new Intl.NumberFormat(
        'tr-TR',
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

    classText.textContent =
        materials.label +
        ' • ' +
        volume.toFixed(2) +
        ' m³ fire dahil beton hacmi için referans karşılığı';

    document.getElementById('materialCement').textContent =
        number0.format(materials.cementKg) +
        ' kg (' +
        number2.format(materials.cementTon) +
        ' ton)';

    document.getElementById('materialCementBag').textContent =
        '≈ ' +
        number0.format(materials.cementBags50) +
        ' adet 50 kg torba eşdeğeri';

    document.getElementById('materialSand').textContent =
        number0.format(materials.sandKg) +
        ' kg (' +
        number2.format(materials.sandTon) +
        ' ton)';

    document.getElementById('materialAggregate').textContent =
        number0.format(materials.aggregateKg) +
        ' kg (' +
        number2.format(materials.aggregateTon) +
        ' ton)';

    document.getElementById('materialWater').textContent =
        number0.format(materials.waterLiters) +
        ' L (' +
        number2.format(materials.waterM3) +
        ' m³)';

    if (materials.additiveKg > 0) {
        document.getElementById('materialAdditive').textContent =
            number2.format(materials.additiveKg) + ' kg';

        additiveBox.style.display = 'block';
    } else {
        additiveBox.style.display = 'none';
    }
}


