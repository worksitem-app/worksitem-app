# Worksitem — yerel geliştirme. Canlı anahtarların tam listesi ve açıklamaları: .env.production.example
APP_NAME=Worksitem
APP_KEY=
# local | staging | production
APP_ENV=local
# production'da MUTLAKA false
APP_DEBUG=true
APP_URL=http://localhost:8000
# Cloudflare / load balancer arkasındaysa: * veya virgüllü IP/CIDR listesi. Boş = proxy yok
TRUSTED_PROXIES=
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# production önerisi: daily (dosya şişmesin) + LOG_DAILY_DAYS=14
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worksitem
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# production'da true önerilir
SESSION_ENCRYPT=false
SESSION_PATH=/
# DİKKAT: ".worksitem.com" verilirse staging (app.) ve prod oturum çerezini paylaşır.
# Her ortam kendi host'unu kullansın: prod → worksitem.com, staging → app.worksitem.com, local → null
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Rate limiter + fiyat cache'i burayı kullanır; production'da redis önerilir
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.worksitem.com
MAIL_PORT=587
MAIL_USERNAME=info@worksitem.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@worksitem.com"
MAIL_FROM_NAME="Worksitem"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── AI SERVİSLERİ ───
GEMINI_API_KEY=
GEMINI_RAYIC_MODEL=gemini-3.6-flash
GEMINI_BOQ_MODEL=gemini-3.6-flash
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
# Tüm kullanıcılar için günlük toplam AI isteği tavanı (maliyet sigortası)
AI_GLOBAL_DAILY_LIMIT=40
AI_GLOBAL_MONTHLY_LIMIT=600
AI_COST_ADVICE_ENABLED=false

# ─── ANALİTİK ───
# Format: G-XXXXXXXXXX (geçersiz format enjekte edilmez)
GA4_MEASUREMENT_ID=

# ─── STAGING ERİŞİM (yalnızca APP_ENV=staging iken) ───
STAGING_ACCESS_USER=
# php -r "echo password_hash('SIFRE', PASSWORD_DEFAULT);"
STAGING_ACCESS_PASSWORD_HASH=

# ─── LEAD & RAPOR ───
LEAD_NOTIFICATION_EMAIL=info@worksitem.com
PRICE_REPORT_EMAIL=info@worksitem.com
# Günlük CEO raporu alıcısı (config/worksitem_leads.php → ceo_report_email)
PRICE_MAIL=info@worksitem.com

# ─── VITE ───
VITE_APP_NAME="${APP_NAME}"
