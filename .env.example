APP_NAME=Worksitem
APP_ENV=local       # production DEĞİL
APP_DEBUG=true      # false DEĞİL
APP_URL=http://localhost:8000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worksitem
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.worksitem.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.worksitem.com
MAIL_PORT=587
MAIL_USERNAME=info@worksitem.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@worksitem.com"
MAIL_FROM_NAME="Worksitem"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── AI SERVİSLERİ ───
GEMINI_API_KEY=
GEMINI_RAYIC_MODEL=gemini-3.6-flash
GEMINI_BOQ_MODEL=gemini-3.6-flash

REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# ─── ANALİTİK ───
GA4_MEASUREMENT_ID=

# ─── STAGING ERİŞİM ───
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD_HASH=

# ─── LEAD & RAPOR ───
LEAD_NOTIFICATION_EMAIL=info@worksitem.com
PRICE_REPORT_EMAIL=info@worksitem.com
PRICE_MAIL=info@worksitem.com

# ─── VITE ───
VITE_APP_NAME="${APP_NAME}"
