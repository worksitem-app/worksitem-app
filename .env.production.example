# ═══════════════════════════════════════════════════════════════
#  Worksitem — CANLI ORTAM şablonu
#  Sunucuda .env olarak kopyalayın, boş değerleri doldurun,
#  ardından: php artisan app:preflight
# ═══════════════════════════════════════════════════════════════
APP_NAME=Worksitem
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://worksitem.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
# Cloudflare kullanılıyorsa: *
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = yalnızca bu host (staging alt alan adıyla çerez paylaşılmaz)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hostinger'da sürekli worker yok; kuyruğa iş atılmıyor. Worker kurulursa database bırakılabilir.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@worksitem.com"
MAIL_FROM_NAME="Worksitem"

GEMINI_API_KEY=
GEMINI_RAYIC_MODEL=gemini-3.6-flash
GEMINI_BOQ_MODEL=gemini-3.6-flash
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
AI_GLOBAL_DAILY_LIMIT=300

GA4_MEASUREMENT_ID=

LEAD_NOTIFICATION_EMAIL=info@worksitem.com
PRICE_REPORT_EMAIL=info@worksitem.com
PRICE_MAIL=info@worksitem.com

VITE_APP_NAME="${APP_NAME}"
