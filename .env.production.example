# ═══════════════════════════════════════════════════════════════
#  Worksitem — CANLI ORTAM şablonu
#  Sunucuda .env olarak kopyalayın, boş değerleri doldurun,
#  ardından: php artisan app:preflight
# ═══════════════════════════════════════════════════════════════
APP_NAME=Worksitem
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://worksitem.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
# Cloudflare kullanılıyorsa: *
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = yalnızca bu host (staging alt alan adıyla çerez paylaşılmaz)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hostinger'da sürekli worker yok; kuyruğa iş atılmıyor. Worker kurulursa database bırakılabilir.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@worksitem.com"
MAIL_FROM_NAME="Worksitem"

# Tam yedek (spatie/laravel-backup, her gece 03:00, son 7 gün) — config/backup.php
# Parola boşsa zip şifresizdir; .env içerdiği için parola önerilir (ayrıca güvenli yerde saklayın)
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=info@worksitem.com

# ── Yapay zekâ ── (kontrol: php artisan ai:check — ücretsiz, anahtarı yazdırmaz)
# Önce Google AI Studio'da aylık bütçe limiti tanımlayın; sonra true yapın.
AI_SPEND_ENABLED=false
GEMINI_API_KEY=
GEMINI_RAYIC_MODEL=gemini-3.6-flash
GEMINI_BOQ_MODEL=gemini-3.6-flash
GEMINI_PRICE_RESEARCH_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_HD_SIZE=2K
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
AI_GLOBAL_DAILY_LIMIT=300
AI_CREDITS_ENABLED=true
AI_FREE_PER_DAY=1

# ── Fiyat robotu (her sabah 06:30; sonuçlar yönetici onayına düşer)
PRICE_ROBOT_ENABLED=true
PRICE_ROBOT_DAILY_LIMIT=55
PRICE_ROBOT_REFRESH_DAYS=7

# ── SMS (Netgsm) — giriş kodu, teklif ve keşif bildirimleri
NETGSM_ENABLED=true
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=worksitem
NETGSM_TEAM_PHONE=
OTP_MAX_PER_PHONE_DAY=5
OTP_MAX_PER_IP_DAY=6
OTP_GLOBAL_DAY=400

# ── Ödeme (iyzico) — canlı adres: https://api.iyzipay.com
ONLINE_PAYMENTS_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_KESIF_ENABLED=false
PRO_REPORT_MODE=lead
PRO_REPORT_PRICE=149
FIRM_PRO_PRICE=2400

# ── Teklif pazaryeri ve firma rehberi (avukat onayına kadar false)
MARKET_ENABLED=false
FIRMS_DIRECTORY_ENABLED=false
MARKET_FREE_UNTIL=2027-03-31
MARKET_FEE_RATE=0.05
MARKET_FEE_MIN=250
MARKET_FEE_MAX=7500
MARKET_MAX_INVITES=5

# ── Şirket kimliği (sözleşmeler ve künye; şirket kurulunca yalnız bunlar değişir)
COMPANY_LEGAL_NAME=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
COMPANY_MERSIS=
COMPANY_KEP=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=info@worksitem.com
COMPANY_BANK_NAME=
COMPANY_IBAN=
COMPANY_IBAN_HOLDER=
COMPANY_MASK_IDS=true

# ── Uygulama (PWA + Google Play) ve web bildirimleri
# VAPID anahtarları: php artisan push:keys --write (gizli anahtar ekrana basılmaz)
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM_B64=
VAPID_SUBJECT=mailto:info@worksitem.com
# Play Console › Uygulama bütünlüğü › SHA-256 (birden çok ise virgülle)
TWA_PACKAGE=com.worksitem.app
TWA_SHA256=
TWA_PLAY_URL=

# ── Analitik ve arama
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

LEAD_NOTIFICATION_EMAIL=info@worksitem.com
PRICE_REPORT_EMAIL=info@worksitem.com
PRICE_MAIL=info@worksitem.com

VITE_APP_NAME="${APP_NAME}"
