<?php

namespace App\Console\Commands;

use App\Models\TenderPoz;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class EnrichPozSeo extends Command
{
    protected $signature = 'poz:enrich-seo
                            {--limit=10 : Kaç poz işlenecek}
                            {--ids-file= : Sadece bu ID dosyasındaki pozları işle}';

    protected $description = 'AI ile poz SEO açıklamalarını zenginleştir';

    public function handle(): int
    {
        $limit = (int) $this->option('limit');
        $idsFile = $this->option('ids-file');

        $query = TenderPoz::query()
            ->where('is_active', true)
            ->where('seo_enriched', false);

        if ($idsFile && file_exists($idsFile)) {
            $ids = json_decode(file_get_contents($idsFile), true);
            if (is_array($ids) && !empty($ids)) {
                $query->whereIn('id', $ids);
                $this->info("Filtre: {$idsFile} (" . count($ids) . " ID)");
            }
        }

        $pozs = $query->orderBy('poz_no')->limit($limit)->get();

        if ($pozs->isEmpty()) {
            $this->warn('İşlenecek poz bulunamadı.');
            return self::SUCCESS;
        }

        $this->info("İşlenecek poz: {$pozs->count()}");
        $bar = $this->output->createProgressBar($pozs->count());
        $bar->start();

        $success = 0;
        $failed = 0;

        foreach ($pozs as $poz) {
            try {
                $this->enrich($poz);
                $success++;
            } catch (\Throwable $e) {
                $failed++;
                Log::error('Poz SEO enrich failed', [
                    'poz_id' => $poz->id,
                    'poz_no' => $poz->poz_no,
                    'error' => $e->getMessage(),
                ]);
            }

            $bar->advance();
            usleep(500000); // 0.5 sn
        }

        $bar->finish();
        $this->newLine(2);
        $this->info("✅ Başarılı: {$success}");
        if ($failed > 0) {
            $this->warn("❌ Başarısız: {$failed}");
        }

        return self::SUCCESS;
    }

    private function enrich(TenderPoz $poz): void
    {
        $apiKey = config('services.gemini.api_key');
        if (empty($apiKey)) {
            throw new \RuntimeException('Gemini API key bulunamadı');
        }

        $prompt = <<<PROMPT
Sen Türk inşaat sektöründe SEO içerik uzmanısın. Şu inşaat pozu için SEO-optimized Türkçe içerik üret:

Poz No: {$poz->poz_no}
Açıklama: {$poz->description}
Birim: {$poz->unit}
Kurum: {$poz->institution}

KURALLAR:
- long_description: 150-250 kelime, doğal Türkçe, SEO uyumlu. Şu başlıkları içer:
  1) Ne olduğu
  2) Nerede/nasıl kullanıldığı  
  3) Teknik özellikleri
  4) Avantajları
- meta_description: Tam 155 karakter (ne eksik ne fazla), SEO için kritik
- meta_keywords: 8-12 anahtar kelime, virgülle ayrılmış
- faq: 3-5 soru-cevap. Kullanıcıların gerçekten soracağı spesifik sorular.

SADECE şu JSON formatında çıktı ver (başka metin yok):
{
  "long_description": "...",
  "meta_description": "...",
  "meta_keywords": "kelime1,kelime2,kelime3",
  "faq": [
    {"q": "Soru 1?", "a": "Cevap 1"},
    {"q": "Soru 2?", "a": "Cevap 2"},
    {"q": "Soru 3?", "a": "Cevap 3"}
  ]
}
PROMPT;

        $response = Http::withHeaders([
            'x-goog-api-key' => $apiKey,
        ])->timeout(60)->post(
            'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent',
            [
                'contents' => [['parts' => [['text' => $prompt]]]],
                'generationConfig' => [
                    'temperature' => 0.3,
                    'maxOutputTokens' => 2000,
                ],
            ]
        );

        if (!$response->successful()) {
            throw new \RuntimeException(
                'Gemini API hata: ' . $response->status()
            );
        }

        $text = $response->json()['candidates'][0]['content']['parts'][0]['text'] ?? '';

        // JSON çıkar
        if (!preg_match('/\{.*\}/s', $text, $matches)) {
            throw new \RuntimeException('AI yanıtı JSON içermiyor');
        }

        $data = json_decode($matches[0], true);
        if (!is_array($data)) {
            throw new \RuntimeException('AI yanıtı geçerli JSON değil');
        }

        $poz->update([
            'long_description' => $data['long_description'] ?? null,
            'meta_description' => $data['meta_description'] ?? null,
            'meta_keywords' => $data['meta_keywords'] ?? null,
            'faq_data' => $data['faq'] ?? null,
            'seo_enriched' => true,
        ]);
    }
}
