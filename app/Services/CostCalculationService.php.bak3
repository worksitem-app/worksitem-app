<?php

namespace App\Services;

use Illuminate\Support\Facades\DB;
use RuntimeException;

class CostCalculationService
{
    public function calculate(int $projectId): float
    {
        $breakdown = $this->calculateBreakdown($projectId);

        return $breakdown['total'];
    }

    public function calculateBreakdown(int $projectId): array
    {
        $project = DB::table('projects')
            ->where('id', $projectId)
            ->first();

        if (!$project) {
            throw new RuntimeException("Proje bulunamadı: {$projectId}");
        }

        $rates = DB::table('cost_rates')
            ->where('project_type_id', $project->project_type_id)
            ->get()
            ->keyBy('key');

        if (!$rates->has('base_price_m2')) {
            throw new RuntimeException(
                'base_price_m2 maliyet parametresi bulunamadı.'
            );
        }

        $answers = DB::table('project_answers')
            ->where('project_id', $projectId)
            ->get()
            ->keyBy('question_id');

        $constructionArea = $this->numberAnswer($answers, 2);

        if ($constructionArea <= 0) {
            throw new RuntimeException(
                'Geçerli bir inşaat alanı bulunamadı.'
            );
        }

        /*
         * 1. Temel maliyet
         */
        $basePrice = (float) $rates['base_price_m2']->value;

        $baseCost = $constructionArea * $basePrice;

        /*
         * 2. Kalite
         */
        $quality = $this->answerValue($answers, 7);

        $qualityMultiplier = 1.0;

        if (
            $quality === 'ust_segment'
            && $rates->has('quality_premium_multiplier')
        ) {
            $qualityMultiplier =
                (float) $rates['quality_premium_multiplier']->value;
        }

        if (
            $quality === 'luks'
            && $rates->has('quality_luxury_multiplier')
        ) {
            $qualityMultiplier =
                (float) $rates['quality_luxury_multiplier']->value;
        }

        $qualityCost = $baseCost * $qualityMultiplier;

        /*
         * 3. Yapı sistemi
         */
        $system = $this->answerValue($answers, 6);

        $systemMultiplier = 1.0;

        if (
            $system === 'celik'
            && $rates->has('system_steel_multiplier')
        ) {
            $systemMultiplier =
                (float) $rates['system_steel_multiplier']->value;
        }

        if (
            $system === 'hibrit'
            && $rates->has('system_hybrid_multiplier')
        ) {
            $systemMultiplier =
                (float) $rates['system_hybrid_multiplier']->value;
        }

        if (
            $system === 'ahsap'
            && $rates->has('system_wood_multiplier')
        ) {
            $systemMultiplier =
                (float) $rates['system_wood_multiplier']->value;
        }

        $constructionCost = $qualityCost * $systemMultiplier;

        /*
         * 4. Havuz
         */
        $pool = $this->answerValue($answers, 8);

        $poolArea = $this->numberAnswer($answers, 14);

        $poolM2Cost = null;
        $poolCost = 0.0;

        if ($pool === 'evet') {

            if (
                $poolArea > 0
                && $rates->has('pool_m2_cost')
            ) {
                $poolM2Cost =
                    (float) $rates['pool_m2_cost']->value;

                $poolCost = $poolArea * $poolM2Cost;

            } elseif ($rates->has('pool_base_cost')) {

                /*
                 * Güvenli geri dönüş:
                 * Havuz alanı yoksa eski maktu maliyet.
                 */
                $poolCost =
                    (float) $rates['pool_base_cost']->value;
            }
        }

        /*
         * 5. Kapalı garaj / otopark
         */
        $garage = $this->answerValue($answers, 9);

        $garageCost = 0.0;

        if (
            $garage === 'evet'
            && $rates->has('garage_base_cost')
        ) {
            $garageCost =
                (float) $rates['garage_base_cost']->value;
        }

        /*
         * 6. Peyzaj
         *
         * Şimdilik ayrı peyzaj alanı sorusu olmadığı
         * için maliyete eklenmiyor.
         */
        $landscapeCost = 0.0;

        /*
         * 7. Toplam
         */
        $total =
            $constructionCost
            + $poolCost
            + $garageCost
            + $landscapeCost;

        $total = round($total, 2);

        /*
         * 8. Projeye kaydet
         */
        DB::table('projects')
            ->where('id', $projectId)
            ->update([
                'estimated_cost' => $total,
                'updated_at' => now(),
            ]);

        return [
            'project_id' => $projectId,

            'construction_area' => $constructionArea,

            'base_price_m2' => $basePrice,
            'base_cost' => round($baseCost, 2),

            'quality' => $quality,
            'quality_multiplier' => $qualityMultiplier,
            'quality_cost' => round($qualityCost, 2),

            'system' => $system,
            'system_multiplier' => $systemMultiplier,
            'construction_cost' => round($constructionCost, 2),

            'pool' => $pool,
            'pool_area' => $poolArea,
            'pool_m2_cost' => $poolM2Cost,
            'pool_cost' => round($poolCost, 2),

            'garage' => $garage,
            'garage_cost' => round($garageCost, 2),

            'landscape_cost' => round($landscapeCost, 2),

            'total' => $total,
        ];
    }

    private function answerValue($answers, int $questionId): ?string
    {
        if (!$answers->has($questionId)) {
            return null;
        }

        $value = $answers[$questionId]->answer_value;

        return $value !== null
            ? trim((string) $value)
            : null;
    }

    private function numberAnswer($answers, int $questionId): float
    {
        $value = $this->answerValue($answers, $questionId);

        if ($value === null || $value === '') {
            return 0;
        }

        return (float) str_replace(',', '.', $value);
    }
}
